# Copy to backend/.env and fill in as needed. All values shown are the
# built-in defaults from app/config.py — .env only needs to override what
# differs from these.

DATABASE_URL=sqlite:///./chessania.sqlite3
SF_PATH=stockfish
SF_DEPTH=12
MAX_GAMES=20
CONTACT_EMAIL=contact@example.com
MAX_CONCURRENT_JOBS=2
CORS_ORIGINS=http://localhost:3000
ENV=dev
